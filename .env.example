# Railway では Postgres を追加すると DATABASE_URL が自動で入る
DATABASE_URL=postgres://postgres:postgres@localhost:5432/karenda
# 外部URL経由で接続するときだけ true（Railway内部接続なら不要）
PGSSL=false
PORT=3000
# 空なら初回起動時に自動生成して DB に保存（固定したい場合だけ npm run vapid の値を入れる）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
