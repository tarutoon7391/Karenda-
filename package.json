{
  "name": "karenda",
  "version": "0.1.0",
  "private": true,
  "description": "ペタッと貼るシール風カレンダー（PWA・1人用）",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "node server/index.js",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "cd client && npm run dev",
    "vapid": "node scripts/generate-vapid.js",
    "yomi": "npm install --no-save kuromoji && node scripts/generate-yomi.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  }
}
